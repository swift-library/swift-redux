{
  "repository": "swift-library/swift-redux",
  "version_file": "VERSION",
  "version_pattern": "^([^\\n]+)\\n?$",
  "changelog": "CHANGELOG.md",
  "check_command": "Scripts/check",
  "ci": {
    "include": [
      {
        "name": "macos-15-swift-6.0",
        "runner": "macos-15",
        "xcode": "16.2"
      },
      {
        "name": "macos-26-swift-6.3",
        "runner": "macos-26",
        "xcode": "26.6"
      },
      {
        "name": "ios-build",
        "runner": "macos-26",
        "xcode": "26.6",
        "command": "xcodebuild -scheme swift-redux-Package -destination generic/platform=iOS -derivedDataPath .build/xcode build"
      }
    ]
  },
  "minimum_swift": "6.0",
  "platforms": {
    "iOS": [
      18,
      26,
      27
    ],
    "macOS": [
      15,
      26,
      27
    ],
    "tvOS": [
      18,
      26,
      27
    ],
    "watchOS": [
      11,
      26,
      27
    ]
  }
}
